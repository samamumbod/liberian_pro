<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.liberianpro">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <permission android:name="android.permission.FLASHLIGHT" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/lib_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/lib_icon"
        android:screenOrientation="portrait"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiberianPro">
        <activity android:name="com.update_book.UpdateBookActivity"
            android:label="Update book">
        </activity>
        <activity android:name="com.theartofdev.edmodo.cropper.CropImageActivity"
            />
        <activity
            android:name="com.department.DepartmentActivity"
            android:label="Department" />
        <activity
            android:name="com.record_book.FinalRecordActivity"
            android:label="Record book" />
        <activity
            android:name="com.return_book.FinalReturnActivity"
            android:label="Return book" />
        <activity
            android:name="com.issue_book.FinalIssueActivity"
            android:label="Issue book" />
        <activity
            android:name="com.school.SchoolActivity"
            android:label="School" />

        <meta-data
            android:name="com.google.android.gms.vision.DEPENDENCIES"
            android:value="barcode" />
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <activity
            android:name="com.settings.SettingsActivity"
            android:label="Settings" />
        <activity
            android:name="com.category.CategoryActivity"
            android:label="Book category" />
        <activity
            android:name="com.return_book.ReturnBookActivity"
            android:label="Return book" />
        <activity
            android:name="com.record_book.RecordBookActivity"
            android:label="ISBN detector"></activity>
        <activity
            android:name="com.issue_book.IssueBookActivity"
            android:label="Issue book" />
        <activity
            android:name="com.signature.SignatureActivity"
            android:label="Signature" />
        <activity
            android:name="com.splash.SplashActivity"
            android:theme="@style/Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.signin.SignInActivity"
            android:theme="@style/Splash" />
        <activity
            android:name=".MainActivity"
            android:theme="@style/Main" />
    </application>

</manifest>